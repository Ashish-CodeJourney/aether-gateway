---
import FailoverDemo from './FailoverDemo.astro';
import CacheDemo from './CacheDemo.astro';
import StreamDemo from './StreamDemo.astro';
import QuotaDemo from './QuotaDemo.astro';

type Props = {benchmarksHref: string};
const {benchmarksHref} = Astro.props;

const TABS = [
  {id: 'failover', label: 'Failover', hint: 'Take a provider down', icon: '<path d="M4 6h6a4 4 0 0 1 4 4 4 4 0 0 0 4 4h2"/><circle cx="4" cy="6" r="1.6"/><circle cx="20" cy="14" r="1.6"/><path d="M4 18h4l3-3"/><circle cx="4" cy="18" r="1.6"/>'},
  {id: 'cache', label: 'Caching', hint: 'Ask the same thing twice', icon: '<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/><path d="M5 11.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/>'},
  {id: 'stream', label: 'Streaming', hint: 'Close the tab mid-answer', icon: '<path d="M3 8h10M3 12h14M3 16h7"/><path d="m17 14 4 4m0-4-4 4"/>'},
  {id: 'quota', label: 'Quotas', hint: 'Drain the token bucket', icon: '<path d="M4 15a8 8 0 1 1 16 0"/><path d="M12 15 16 9"/><circle cx="12" cy="15" r="1.3"/>'},
];
---

<div class="demos" data-demos>
  <div class="demo-tabs" role="tablist" aria-label="Interactive demos">
    {
      TABS.map((t, i) => (
        <button
          type="button"
          class="demo-tab"
          role="tab"
          id={`demo-tab-${t.id}`}
          aria-controls={`demo-panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={t.id}
        >
          <span class="demo-tab-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
          </span>
          <span class="demo-tab-text">
            <span class="demo-tab-label">{t.label}</span>
            <span class="demo-tab-hint">{t.hint}</span>
          </span>
        </button>
      ))
    }
  </div>

  <div class="demo-panels">
    <section class="demo-panel is-active" role="tabpanel" id="demo-panel-failover" aria-labelledby="demo-tab-failover" data-panel="failover">
      <FailoverDemo benchmarksHref={benchmarksHref} />
    </section>
    <section class="demo-panel" role="tabpanel" id="demo-panel-cache" aria-labelledby="demo-tab-cache" data-panel="cache">
      <CacheDemo />
    </section>
    <section class="demo-panel" role="tabpanel" id="demo-panel-stream" aria-labelledby="demo-tab-stream" data-panel="stream">
      <StreamDemo />
    </section>
    <section class="demo-panel" role="tabpanel" id="demo-panel-quota" aria-labelledby="demo-tab-quota" data-panel="quota">
      <QuotaDemo />
    </section>
  </div>
</div>

<style is:global>
  .demos {
    display: grid;
    gap: 1.25rem;
  }
  .demo-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    padding: 0.45rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  .demo-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 13px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .demo-tab:hover {
    background: var(--tint);
  }
  .demo-tab[aria-selected='true'] {
    background: #ffffff;
    border-color: #a5e9f5;
    box-shadow: var(--shadow-md);
  }
  .demo-tab-icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 11px;
    background: var(--tint-2);
    color: var(--teal);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .demo-tab[aria-selected='true'] .demo-tab-icon {
    background: linear-gradient(135deg, #06b6d4, #2563eb);
    color: #ffffff;
  }
  .demo-tab-text {
    display: grid;
    min-width: 0;
  }
  .demo-tab-label {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }
  .demo-tab-hint {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .js .demo-panel:not(.is-active) {
    display: none;
  }
  .no-js .demo-panel + .demo-panel {
    margin-top: 1.25rem;
  }
  .demo-panel:focus-visible {
    outline-offset: 6px;
  }
  @media (max-width: 860px) {
    .demo-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 420px) {
    .demo-tab {
      padding: 0.6rem;
      gap: 0.5rem;
    }
    .demo-tab-icon {
      width: 2rem;
      height: 2rem;
    }
    .demo-tab-hint {
      display: none;
    }
  }

  /* ---- shared demo card ---- */
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: 22px;
    background: #ffffff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }
  @media (max-width: 900px) {
    .demo {
      grid-template-columns: minmax(0, 1fr);
      padding: 0.9rem;
    }
  }
  .demo-stage {
    position: relative;
    padding: 1.25rem;
    border-radius: 16px;
    background:
      radial-gradient(30rem 14rem at 0% 0%, rgba(207, 245, 251, 0.55), transparent 70%),
      radial-gradient(30rem 14rem at 100% 100%, rgba(220, 232, 255, 0.55), transparent 70%),
      var(--tint);
    border: 1px solid var(--border);
    min-width: 0;
  }
  .demo-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1rem;
  }
  .demo-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .demo-head .sim-label {
    margin-left: auto;
  }
  .demo-desc {
    font-size: 0.92rem;
    color: var(--muted);
    margin-bottom: 1.1rem;
  }
  .demo-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .demo-side {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-width: 0;
  }
  .resp {
    border-radius: 14px;
    background: var(--code-bg);
    color: var(--code-text);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .resp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--code-dim);
  }
  .resp-status {
    font-family: var(--font-mono);
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.76rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: rgba(52, 211, 153, 0.15);
    color: #6ee7b7;
  }
  .resp-status[data-tone='bad'] {
    background: rgba(248, 113, 113, 0.15);
    color: #fca5a5;
  }
  .resp-status[data-tone='idle'] {
    background: rgba(148, 163, 184, 0.15);
    color: var(--code-dim);
  }
  .resp pre {
    margin: 0;
    padding: 0.85rem 1rem 1rem;
    font-size: 0.78rem;
    line-height: 1.8;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .resp .h-line {
    display: block;
  }
  .flash {
    animation: flash 0.6s ease;
  }
  @keyframes flash {
    from {
      background: rgba(34, 211, 238, 0.3);
    }
  }
  .measured {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    border: 1px solid #bfe9f2;
    background: linear-gradient(135deg, #f0fbfe, #eef4ff);
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .measured strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--teal);
    white-space: nowrap;
  }
  .measured-tag {
    display: inline-block;
    margin-bottom: 0.2rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ok);
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid var(--border);
    display: grid;
    gap: 0.4rem;
    font-size: 0.83rem;
    color: var(--ink-2);
    min-height: 6.5rem;
    align-content: start;
  }
  .log li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    animation: log-in 0.3s ease both;
  }
  .log .log-empty {
    color: var(--faint);
    animation: none;
  }
  @keyframes log-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--faint);
    transform: translateY(-1px);
  }
  .dot-ok {
    background: #10b981;
  }
  .dot-bad {
    background: #ef4444;
  }
  .dot-warn {
    background: #f59e0b;
  }
  .dot-info {
    background: #06b6d4;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-demos]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus: boolean) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector(`[data-panel="${t.dataset.tab}"]`)?.classList.toggle('is-active', on);
      });
      if (focus) tab.focus();
      root.dispatchEvent(new CustomEvent('demo:show', {detail: tab.dataset.tab}));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1};
        if (!(e.key in keys)) return;
        e.preventDefault();
        select(tabs[(keys[e.key] + tabs.length) % tabs.length], true);
      });
    });
  }
</script>
