---
const CAPACITY = 8;
const BUDGET = 20000;
---

<div class="demo qu" data-qu data-capacity={CAPACITY} data-budget={BUDGET}>
  <div class="demo-stage">
    <div class="demo-head">
      <h3 class="demo-title">Drain the token bucket</h3>
      <span class="sim-label">Simulated in your browser</span>
    </div>
    <p class="demo-desc">
      Every API key has its own rate limit and monthly token budget. Tokens are reserved before the provider call and
      reconciled to the real count afterwards. Empty the bucket and the next request gets a <code>429</code> with
      <code>Retry-After</code> &ndash; then watch it refill.
    </p>

    <div class="qu-block">
      <div class="qu-label">
        <span>Rate limit &middot; key <code>team-a</code></span>
        <span class="qu-meta"><span data-qu-level>{CAPACITY}</span> / {CAPACITY} tokens &middot; refills 1 per second</span>
      </div>
      <div class="qu-bucket" data-qu-bucket aria-hidden="true">
        {Array.from({length: CAPACITY}, () => <span class="qu-cell is-full"></span>)}
      </div>
    </div>

    <div class="qu-block">
      <div class="qu-label">
        <span>Monthly budget</span>
        <span class="qu-meta"><span data-qu-remaining>{BUDGET.toLocaleString('en-US')}</span> of {BUDGET.toLocaleString('en-US')} tokens left</span>
      </div>
      <div class="qu-budget" aria-hidden="true">
        <span class="qu-used" data-qu-used></span><span class="qu-reserved" data-qu-reserved></span>
      </div>
      <div class="qu-legend" aria-hidden="true">
        <span><i class="qu-key-used"></i>used</span>
        <span><i class="qu-key-reserved"></i>reserved, in flight</span>
      </div>
    </div>

    <div class="demo-controls">
      <button type="button" class="chip-btn chip-btn-primary" data-qu-send>
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="currentColor"><path d="M2 2.5 14 8 2 13.5l2-5.5z"></path></svg>
        Send request
      </button>
      <button type="button" class="chip-btn" data-qu-burst>Burst &times;6</button>
    </div>
  </div>

  <div class="demo-side">
    <div class="resp">
      <div class="resp-head">
        <span>Last response</span>
        <span class="resp-status" data-tone="idle" data-qu-status>waiting</span>
      </div>
      <pre data-qu-headers><code><span class="h-line h-dim">Send a request to see the headers.</span></code></pre>
    </div>
    <ol class="log" aria-live="polite" aria-label="Recent requests" data-qu-log>
      <li class="log-empty">No requests yet.</li>
    </ol>
    <div class="measured">
      <div>
        <span class="measured-tag">Measured</span>
        <p>
          <strong>0 over-issue</strong> with 100 concurrent requests against a 50-token budget: exactly 50 allowed, 50
          rejected.
        </p>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .qu-block {
    padding: 1rem;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  .qu-block + .qu-block {
    margin-top: 0.75rem;
  }
  .qu-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--ink);
    margin-bottom: 0.7rem;
  }
  .qu-meta {
    font-weight: 500;
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .qu-bucket {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.4rem;
  }
  .qu-cell {
    height: 2.1rem;
    border-radius: 9px;
    border: 1.5px dashed #cbd9e7;
    background: transparent;
    transition:
      background-color 0.3s ease,
      transform 0.3s ease,
      border-color 0.3s ease;
  }
  .qu-cell.is-full {
    border-style: solid;
    border-color: transparent;
    background: linear-gradient(160deg, #67e8f9, #0ea5e9 70%, #2563eb);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .qu-cell.is-pop {
    animation: pop 0.35s ease;
  }
  @keyframes pop {
    40% {
      transform: scale(0.8);
    }
  }
  .qu-bucket.is-empty {
    animation: shake 0.4s ease;
  }
  .qu-bucket.is-empty .qu-cell {
    border-color: #f5b4b4;
  }
  .qu-budget {
    display: flex;
    height: 12px;
    border-radius: 999px;
    background: #e2edf7;
    overflow: hidden;
  }
  .qu-budget span {
    display: block;
    height: 100%;
    width: 0;
    transition: width 0.45s ease;
  }
  .qu-used {
    background: linear-gradient(90deg, #22d3ee, #2563eb);
  }
  .qu-reserved {
    background: repeating-linear-gradient(135deg, #fbbf24 0 6px, #fde68a 6px 12px);
  }
  .qu-legend {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.74rem;
    color: var(--muted);
  }
  .qu-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .qu-legend i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
  .qu-key-used {
    background: #0ea5e9;
  }
  .qu-key-reserved {
    background: #fbbf24;
  }
  @media (max-width: 420px) {
    .qu-bucket {
      gap: 0.25rem;
    }
    .qu-cell {
      height: 1.7rem;
      border-radius: 7px;
    }
  }
</style>

<script>
  import {sleep, watchVisibility} from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-qu]');
  if (root) setup(root);

  function setup(root: HTMLElement) {
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    const bucket = q<HTMLElement>('[data-qu-bucket]');
    const levelEl = q<HTMLElement>('[data-qu-level]');
    const remainingEl = q<HTMLElement>('[data-qu-remaining]');
    const usedBar = q<HTMLElement>('[data-qu-used]');
    const reservedBar = q<HTMLElement>('[data-qu-reserved]');
    const status = q<HTMLElement>('[data-qu-status]');
    const headers = q<HTMLElement>('[data-qu-headers]');
    const log = q<HTMLElement>('[data-qu-log]');
    const sendBtn = q<HTMLButtonElement>('[data-qu-send]');
    const burstBtn = q<HTMLButtonElement>('[data-qu-burst]');
    if (!bucket || !levelEl || !remainingEl || !usedBar || !reservedBar || !status || !headers || !log || !sendBtn || !burstBtn) return;

    const capacity = Number(root.dataset.capacity);
    const budget = Number(root.dataset.budget);
    const cells = Array.from(bucket.querySelectorAll<HTMLElement>('.qu-cell'));
    const RESERVE = 512;
    let level = capacity;
    let used = 0;
    let reserved = 0;
    let seq = 0;
    const entries: string[] = [];

    const fmt = (n: number) => n.toLocaleString('en-US');
    const hl = (k: string, v: string, cls = 'h-val') => `<span class="h-line"><span class="h-key">${k}:</span> <span class="${cls}">${v}</span></span>`;
    const renderBucket = () => {
      cells.forEach((c, i) => c.classList.toggle('is-full', i < level));
      levelEl.textContent = String(level);
    };
    const renderBudget = () => {
      usedBar.style.width = `${(used / budget) * 100}%`;
      reservedBar.style.width = `${(reserved / budget) * 100}%`;
      remainingEl.textContent = fmt(budget - used - reserved);
    };
    const pushLog = (tone: string, html: string) => {
      entries.unshift(`<li><span class="dot dot-${tone}" aria-hidden="true"></span><span>${html}</span></li>`);
      entries.length = Math.min(entries.length, 5);
      log.innerHTML = entries.join('');
    };

    const request = async () => {
      seq += 1;
      const n = seq;
      if (level <= 0) {
        bucket.classList.remove('is-empty');
        void bucket.offsetWidth;
        bucket.classList.add('is-empty');
        status.dataset.tone = 'bad';
        status.textContent = '429 Too Many Requests';
        headers.innerHTML = `<code>${hl('Retry-After', '1', 'h-bad')}${hl('X-Aether-Quota-Remaining', fmt(budget - used - reserved))}${hl('type', '…/problems/rate-limit-exceeded', 'h-bad')}</code>`;
        pushLog('bad', `#${n} <b>429</b> rate-limit-exceeded &middot; retry in 1 s, no provider call`);
        return;
      }
      level -= 1;
      cells[level]?.classList.add('is-pop');
      setTimeout(() => cells[level]?.classList.remove('is-pop'), 400);
      renderBucket();
      reserved += RESERVE;
      renderBudget();
      pushLog('warn', `#${n} reserved ${RESERVE} tokens, calling provider…`);
      await sleep(700 + Math.random() * 300);
      const actual = 40 + Math.round(Math.random() * 160);
      reserved -= RESERVE;
      used += actual;
      renderBudget();
      status.dataset.tone = 'ok';
      status.textContent = '200 OK';
      headers.innerHTML = `<code>${hl('X-Aether-Quota-Remaining', fmt(budget - used - reserved), 'h-ok')}${hl('X-Aether-Cost-USD', (actual * 0.0000006).toFixed(7))}${hl('X-Aether-Cache', 'MISS')}</code>`;
      pushLog('ok', `#${n} <b>200</b> &middot; reconciled ${RESERVE} → ${actual} tokens, ${RESERVE - actual} released`);
    };

    sendBtn.addEventListener('click', () => void request());
    burstBtn.addEventListener('click', async () => {
      for (let i = 0; i < 6; i++) {
        void request();
        await sleep(110);
      }
    });

    let visible = false;
    watchVisibility(root, (v) => (visible = v), 0.1);
    setInterval(() => {
      if (!visible || level >= capacity) return;
      level += 1;
      renderBucket();
    }, 1000);
  }
</script>
