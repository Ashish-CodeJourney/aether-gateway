    <script>
      import {countTo, reducedMotion, watchVisibility} from '../scripts/motion';

      const revealables = document.querySelectorAll<HTMLElement>('.reveal');
      if (reducedMotion() || !('IntersectionObserver' in window)) {
        revealables.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }),
          {rootMargin: '0px 0px -8% 0px', threshold: 0.08},
        );
        revealables.forEach((el) => io.observe(el));
      }

      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const to = Number(el.dataset.count);
        const decimals = Number(el.dataset.decimals ?? '0');
        let done = false;
        watchVisibility(el, (visible) => {
          if (!visible || done) return;
          done = true;
          el.dataset.current = '0';
          countTo(el, to, decimals, 1400);
        }, 0.6);
      });

      const marquee = document.querySelector<HTMLElement>('[data-marquee]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
      if (marquee && toggle) {
        const set = (paused: boolean) => {
          marquee.toggleAttribute('data-paused', paused);
          toggle.setAttribute('aria-pressed', String(paused));
          toggle.textContent = paused ? 'Play logos' : 'Pause logos';
        };
        toggle.addEventListener('click', () => set(!marquee.hasAttribute('data-paused')));
      }
    </script>

