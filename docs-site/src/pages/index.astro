---
import RequestFlow from '../components/landing/RequestFlow.astro';
import DemoTabs from '../components/landing/DemoTabs.astro';
import QuickstartTerminal from '../components/landing/QuickstartTerminal.astro';
import {PROVIDERS, iconStyle} from '../components/landing/providers';

// `trailingSlash: 'never'` (astro.config.mjs) also strips BASE_URL's own
// trailing slash, so every link below explicitly joins with `/`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const REPO = 'https://github.com/Ashish-CodeJourney/aether-gateway';
const BLOB = `${REPO}/blob/trunk`;
const SITE = `https://ashish-codejourney.github.io${base}`;

const TITLE = 'Aether Gateway - one OpenAI-compatible endpoint for every LLM provider';
const DESCRIPTION =
  'Free, open-source, self-hosted LLM gateway. Point any OpenAI SDK at it and get multi-provider failover, exact and semantic caching, per-key quotas and per-request cost tracking. MIT licensed.';

const LINKS = {
  start: `${base}/docs/getting-started/`,
  docs: `${base}/docs/`,
  usage: `${base}/docs/usage/`,
  adr: `${base}/docs/adr/hexagonal-module-layout/`,
  architecture: `${base}/docs/design/architecture-diagram/`,
  github: REPO,
  benchmarks: `${BLOB}/BENCHMARKS.md`,
  license: `${BLOB}/LICENSE`,
  security: `${BLOB}/SECURITY.md`,
  contributing: `${BLOB}/CONTRIBUTING.md`,
  conduct: `${BLOB}/CODE_OF_CONDUCT.md`,
};

const MARQUEE: {label: string; icon?: string; badge?: string; tag?: string}[] = [
  ...PROVIDERS.map((p) => ('icon' in p ? {label: p.name, icon: p.icon} : {label: p.name, badge: p.badge})),
  {label: 'vLLM', icon: 'vllm', tag: 'OpenAI-compatible'},
  {label: 'Hugging Face TGI', icon: 'huggingface', tag: 'OpenAI-compatible'},
  {label: 'Any OpenAI-compatible API', badge: '{ }'},
];

const STATS: {value: number; decimals: number; unit: string; label: string; detail: string}[] = [
  {value: 8.9, decimals: 1, unit: 'ms', label: 'Cache-hit latency', detail: 'p95, end to end, confirmed EXACT_HIT'},
  {value: 67.92, decimals: 2, unit: 'ms', label: 'Failover to a healthy provider', detail: 'p99 across 100 injected outages'},
  {value: 500, decimals: 0, unit: '/500', label: 'Streams survived a rolling update', detail: 'Kubernetes, run twice, zero broken'},
  {value: 7.23, decimals: 2, unit: 'ms', label: 'Prompt embedding for semantic cache', detail: 'mean, all-MiniLM-L6-v2'},
];

const FEATURES: {title: string; icon: string; body: string}[] = [
  {
    title: 'Automatic failover',
    icon: 'route',
    body: 'Circuit breakers, retries and bulkheads move traffic to the next provider in the chain, so a provider outage never becomes your outage.',
  },
  {
    title: 'Response caching',
    icon: 'cache',
    body: 'Identical requests are answered from cache for $0. Semantic matching for near-duplicate prompts is opt-in per route, with an entity and number guard.',
  },
  {
    title: 'Quotas per API key',
    icon: 'gauge',
    body: 'Rate limits, concurrency caps and monthly token budgets, reserved atomically in Redis before the call and reconciled to the real count after.',
  },
  {
    title: 'Cost on every response',
    icon: 'ledger',
    body: '<code>X-Aether-Cost-USD</code>, <code>X-Aether-Provider</code> and <code>X-Aether-Cache</code> tell you what a call cost, who served it and whether it hit cache.',
  },
  {
    title: 'Streaming that stops when users leave',
    icon: 'stream',
    body: 'SSE relayed token by token. A client disconnect cancels the upstream call, so you stop paying for tokens nobody will read.',
  },
  {
    title: 'Tool calling and embeddings',
    icon: 'tool',
    body: 'OpenAI-format <code>tools</code> and <code>tool_calls</code> pass through, streaming included, and <code>/v1/embeddings</code> gets the same auth, failover and cost headers.',
  },
  {
    title: 'Observability and console',
    icon: 'chart',
    body: 'Prometheus metrics and a ready-made Grafana dashboard, plus an operator console for API keys, versioned prompts, cache stats and the request log.',
  },
  {
    title: 'Kubernetes-ready',
    icon: 'k8s',
    body: 'Plain manifests with graceful SSE drain, a PodDisruptionBudget and a NetworkPolicy, proven against real zero-downtime rolling updates.',
  },
];

const ICONS: Record<string, string> = {
  route:
    '<path d="M4 6h6a4 4 0 0 1 4 4 4 4 0 0 0 4 4h2"/><circle cx="4" cy="6" r="1.6"/><circle cx="20" cy="14" r="1.6"/><path d="M4 18h4l3-3"/><circle cx="4" cy="18" r="1.6"/>',
  cache:
    '<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/><path d="M5 11.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/>',
  gauge: '<path d="M4 15a8 8 0 1 1 16 0"/><path d="M12 15 16 9"/><circle cx="12" cy="15" r="1.3"/>',
  ledger: '<rect x="5" y="3.5" width="14" height="17" rx="1.5"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4"/>',
  stream: '<path d="M3 8h10M3 12h14M3 16h7"/><path d="m17 14 4 4m0-4-4 4"/>',
  tool: '<path d="M14.5 6.5a4 4 0 0 0-5.3 5.3L4 17v3h3l5.2-5.2a4 4 0 0 0 5.3-5.3L15 12l-3-3Z"/>',
  chart: '<path d="M4 4v16h16"/><path d="m7 15 4-5 3 3 5-6"/>',
  k8s: '<path d="M12 3.5 19.5 8v8L12 20.5 4.5 16V8Z"/><path d="M12 3.5v17M4.5 8l7.5 4.5M19.5 8 12 12.5M4.5 16l7.5-4.5M19.5 16 12 12.5"/>',
};

const FLOW: {title: string; body: string; infra: string}[] = [
  {title: 'Authenticate', body: 'API key resolves to its own limits and budget.', infra: 'Postgres'},
  {title: 'Enforce quota', body: 'Token bucket and budget reserved atomically.', infra: 'Redis'},
  {title: 'Check cache', body: 'Exact match, plus semantic nearest neighbour where a route opts in.', infra: 'pgvector'},
  {title: 'Route & fail over', body: 'Policy picks a provider chain; breakers skip the unhealthy.', infra: 'routing.yaml'},
  {title: 'Stream', body: 'SSE relayed as it arrives; disconnect cancels upstream.', infra: 'WebFlux'},
  {title: 'Account', body: 'Tokens, cost, cache write and metrics, off the hot path.', infra: 'Prometheus'},
];

const COMPARE_COLUMNS = ['Aether Gateway', 'LiteLLM', 'Portkey Gateway', 'Build your own'];
const COMPARE_ROWS: {label: string; cells: string[]}[] = [
  {label: 'Runtime', cells: ['Java 25 · Spring Boot 4.1 (JVM)', 'Python', 'TypeScript', 'Your stack']},
  {
    label: 'License',
    cells: ['MIT, no paid edition', 'MIT core, enterprise features licensed separately', 'MIT gateway, managed platform available', 'Yours'],
  },
  {
    label: 'Self-hosting',
    cells: [
      'One <code>docker compose</code> stack: gateway, Postgres + pgvector, Redis, Prometheus, Grafana',
      'Supported',
      'Supported',
      'You design, build and operate it',
    ],
  },
];
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:image" content={`${SITE}/img/social-card.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE}/img/social-card.jpg`} />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href={`${base}/`}>
          <img src={`${base}/logo.svg`} alt="Aether Gateway home" width="177" height="30" />
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            <li class="nav-hide-sm"><a href={LINKS.docs}>Docs</a></li>
            <li class="nav-hide-sm"><a href="#demos">See it work</a></li>
            <li class="nav-hide-md"><a href="#benchmarks">Benchmarks</a></li>
            <li class="nav-hide-md"><a href="#compare">Compare</a></li>
            <li>
              <a class="nav-icon" href={LINKS.github} aria-label="Aether Gateway on GitHub">
                <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor"
                  ><path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  ></path></svg
                >
              </a>
            </li>
            <li><a class="button button-primary button-sm" href={LINKS.start}>Get started</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-bg" aria-hidden="true">
          <span class="blob blob-1"></span>
          <span class="blob blob-2"></span>
          <span class="blob blob-3"></span>
          <span class="hero-grid-lines"></span>
        </div>
        <div class="container hero-inner">
          <a class="pill reveal" href={LINKS.license}>
            <span class="pill-tag">MIT</span>
            Free &amp; open source <span aria-hidden="true">·</span> self-hosted
            <span aria-hidden="true" class="pill-arrow">&rarr;</span>
          </a>
          <h1 id="hero-title" class="hero-title reveal">
            One endpoint for <span class="grad-text">every LLM provider.</span>
          </h1>
          <p class="hero-lede reveal">
            Aether is a self-hosted gateway that speaks the OpenAI API. Point the SDK you already use at it and get
            automatic failover, caching, per-key quotas and the cost of every call &ndash; without touching your
            application code.
          </p>
          <div class="cta-row reveal">
            <a class="button button-primary button-lg" href={LINKS.start}>
              Get started <span aria-hidden="true">&rarr;</span>
            </a>
            <a class="button button-ghost button-lg" href={LINKS.github}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"
                ><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8L3.5 9.7l5.9-.9Z"></path></svg
              >
              Star on GitHub
            </a>
          </div>
          <p class="hero-meta reveal">
            <code class="hero-cmd"><span aria-hidden="true">$ </span>docker compose up -d</code>
            <span>Java 25 · Spring Boot 4.1 · Docker Compose &amp; Kubernetes</span>
          </p>
        </div>
        <div class="container hero-flow reveal" id="flow">
          <RequestFlow />
        </div>
      </section>

      <section class="providers" aria-labelledby="providers-title">
        <div class="container">
          <div class="providers-head">
            <h2 id="providers-title" class="kicker">One OpenAI-compatible API in front of</h2>
            <button type="button" class="chip-btn chip-btn-quiet marquee-toggle" data-marquee-toggle aria-pressed="false">
              Pause logos
            </button>
          </div>
        </div>
        <div class="marquee" data-marquee>
          {
            [0, 1].map((copy) => (
              <ul class="marquee-track" aria-hidden={copy === 1 ? 'true' : undefined}>
                {MARQUEE.map((m) => (
                  <li class="marquee-item">
                    {m.icon ? (
                      <span class="p-icon" role={copy === 0 ? 'img' : undefined} aria-label={copy === 0 ? `${m.label} logo` : undefined} style={iconStyle(m.icon)} />
                    ) : (
                      <span class="p-badge" aria-hidden="true">{m.badge}</span>
                    )}
                    <span>{m.label}</span>
                    {m.tag && <span class="marquee-tag">{m.tag}</span>}
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
        <div class="container">
          <p class="trademark-note">Product names and logos are trademarks of their respective owners. Aether is not affiliated with them.</p>
        </div>
      </section>

      <section id="benchmarks" class="section stats" aria-labelledby="stats-title">
        <div class="container">
          <div class="section-head section-head-center reveal">
            <p class="eyebrow">Benchmarks</p>
            <h2 id="stats-title" class="section-title">Measured, not estimated.</h2>
            <p class="section-lede">
              Every number comes from a committed run against the real stack. The harness, raw CSVs and methodology
              are in the repository &ndash; reproduce them with <code>make bench</code>.
            </p>
          </div>
          <dl class="stat-grid">
            {
              STATS.map((s, i) => (
                <div class="stat reveal" style={`--d:${i * 80}ms`}>
                  <dt class="stat-label">{s.label}</dt>
                  <dd class="stat-value">
                    <span class="stat-num" data-count={s.value} data-decimals={s.decimals}>
                      {s.value.toFixed(s.decimals)}
                    </span>
                    <span class="stat-unit">{s.unit}</span>
                  </dd>
                  <dd class="stat-detail">{s.detail}</dd>
                </div>
              ))
            }
          </dl>
          <p class="section-link reveal">
            <a href={LINKS.benchmarks}>Read the full benchmark report <span aria-hidden="true">&rarr;</span></a>
          </p>
        </div>
      </section>

      <section id="demos" class="section section-tint" aria-labelledby="demos-title">
        <div class="container">
          <div class="section-head section-head-center reveal">
            <p class="eyebrow">See it work</p>
            <h2 id="demos-title" class="section-title">Break things. Watch Aether handle it.</h2>
            <p class="section-lede">
              Four interactive walkthroughs of what the gateway does on every request. They run in your browser and
              mirror the real behaviour and headers; only numbers marked <em>measured</em> come from benchmarks.
            </p>
          </div>
          <div class="reveal">
            <DemoTabs benchmarksHref={LINKS.benchmarks} />
          </div>
        </div>
      </section>

      <section id="quickstart" class="section" aria-labelledby="qs-title">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">Drop-in</p>
            <h2 id="qs-title" class="section-title">Change two lines. Keep your SDK.</h2>
            <p class="section-lede">
              Aether speaks the OpenAI API &ndash; chat completions, streaming, tool calling and embeddings &ndash; so
              the client you already use keeps working. Swap the base URL and key, and every response starts telling
              you what it cost.
            </p>
          </div>
          <div class="reveal">
            <QuickstartTerminal />
          </div>
        </div>
      </section>

      <section class="section section-tint" aria-labelledby="features-title">
        <div class="container">
          <div class="section-head section-head-center reveal">
            <p class="eyebrow">Features</p>
            <h2 id="features-title" class="section-title">Everything around the model call.</h2>
            <p class="section-lede">
              Calling a model is one line. Keeping it fast, affordable and up when a provider is not is the hard part
              &ndash; that is what Aether does.
            </p>
          </div>
          <ul class="feature-grid">
            {
              FEATURES.map((f, i) => (
                <li class="feature reveal" style={`--d:${(i % 4) * 70}ms`}>
                  <span class="feature-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[f.icon]} />
                  </span>
                  <h3 class="feature-title">{f.title}</h3>
                  <p class="feature-body" set:html={f.body} />
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section" aria-labelledby="flow-title">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">How it works</p>
            <h2 id="flow-title" class="section-title">One request, six steps, one response.</h2>
            <p class="section-lede">
              Every request runs through the same pipeline, and the response headers tell you what happened. On a
              cache hit, routing and streaming are skipped entirely &ndash; <code>X-Aether-Cache: EXACT_HIT</code>,
              <code>X-Aether-Cost-USD: 0</code>.
            </p>
          </div>
          <ol class="pipeline">
            {
              FLOW.map((step, i) => (
                <li class="pipe-step reveal" style={`--d:${i * 70}ms`}>
                  <span class="pipe-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="pipe-title">{step.title}</h3>
                  <p class="pipe-body">{step.body}</p>
                  <span class="pipe-infra">{step.infra}</span>
                </li>
              ))
            }
          </ol>
          <p class="section-link reveal">
            <a href={LINKS.architecture}>See the full architecture <span aria-hidden="true">&rarr;</span></a>
          </p>
        </div>
      </section>

      <section id="compare" class="section section-tint" aria-labelledby="compare-title">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">Compare</p>
            <h2 id="compare-title" class="section-title">Where Aether fits.</h2>
            <p class="section-lede">
              There are good LLM gateways already. Here is an honest look at how Aether differs, so you can pick the
              right one.
            </p>
          </div>
          <div class="table-wrap reveal" role="region" aria-labelledby="compare-title" tabindex="0">
            <table class="compare">
              <thead>
                <tr>
                  <td></td>
                  {COMPARE_COLUMNS.map((c, i) => <th scope="col" class={i === 0 ? 'is-us' : undefined}>{c}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  COMPARE_ROWS.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      {row.cells.map((cell, i) => (
                        <td class={i === 0 ? 'is-us' : undefined} set:html={cell} />
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="fit-grid">
            <div class="fit fit-yes reveal">
              <h3>Aether is a good fit if you&hellip;</h3>
              <ul>
                <li>run on the JVM, or want a gateway your Java team can read and extend</li>
                <li>want one self-hosted stack with caching, quotas, metrics and dashboards included</li>
                <li>want performance numbers you can reproduce yourself, not just read</li>
                <li>need a plain MIT license with no paid edition</li>
              </ul>
            </div>
            <div class="fit fit-no reveal" style="--d:80ms">
              <h3>Look elsewhere if you&hellip;</h3>
              <ul>
                <li>need the widest provider catalogue today &ndash; LiteLLM and Portkey support many more</li>
                <li>want a fully managed, hosted service instead of running your own</li>
                <li>want an in-process Python library rather than a network gateway</li>
              </ul>
            </div>
          </div>
          <p class="footnote">
            Details about other projects are summarised from their public repositories and may change; check their
            documentation for current status.
          </p>
        </div>
      </section>

      <section class="final" aria-labelledby="cta-title">
        <div class="container">
          <div class="final-card reveal">
            <div class="final-bg" aria-hidden="true"><span class="blob blob-1"></span><span class="blob blob-2"></span></div>
            <div class="final-copy">
              <h2 id="cta-title" class="final-title">Your first request is a minute away.</h2>
              <p class="final-lede">
                One command brings up the gateway, Postgres + pgvector, Redis, two mock providers for failover demos,
                Prometheus and Grafana &ndash; seeded and ready.
              </p>
              <div class="cta-row">
                <a class="button button-primary button-lg" href={LINKS.start}>
                  Get started <span aria-hidden="true">&rarr;</span>
                </a>
                <a class="button button-ghost button-lg" href={LINKS.github}>Star on GitHub</a>
              </div>
            </div>
            <pre class="final-term" aria-label="Quickstart commands"><code><span class="t-dim">$</span> git clone {REPO}.git
<span class="t-dim">$</span> cd aether-gateway
<span class="t-dim">$</span> docker compose up -d
<span class="t-dim"># gateway on :8080 · Grafana on :3000</span></code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href={`${base}/`}>
            <img src={`${base}/logo.svg`} alt="Aether Gateway home" width="165" height="28" />
          </a>
          <p>A free, open-source, self-hosted LLM gateway. Released under the MIT License.</p>
        </div>
        <nav aria-label="Documentation">
          <h2 class="footer-title">Docs</h2>
          <ul>
            <li><a href={LINKS.docs}>Introduction</a></li>
            <li><a href={LINKS.start}>Getting started</a></li>
            <li><a href={LINKS.usage}>Usage guide</a></li>
            <li><a href={LINKS.adr}>Architecture decisions</a></li>
          </ul>
        </nav>
        <nav aria-label="Project">
          <h2 class="footer-title">Project</h2>
          <ul>
            <li><a href={LINKS.github}>GitHub</a></li>
            <li><a href={LINKS.benchmarks}>Benchmarks</a></li>
            <li><a href={LINKS.contributing}>Contributing</a></li>
            <li><a href={LINKS.conduct}>Code of Conduct</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal">
          <h2 class="footer-title">Legal</h2>
          <ul>
            <li><a href={LINKS.license}>MIT License</a></li>
            <li><a href={LINKS.security}>Security policy</a></li>
          </ul>
