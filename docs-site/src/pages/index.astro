---
// `trailingSlash: 'never'` (astro.config.mjs) also strips BASE_URL's own
// trailing slash, so every link below explicitly joins with `/`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const STATS: {value: string; label: string; note?: string}[] = [
  {value: '8.9ms', label: 'Cache-hit latency, p95', note: 'target: 50ms'},
  {value: '67.92ms', label: 'Failover latency, p99 (100 trials)', note: 'target: 500ms'},
  {value: '500/500', label: 'Concurrent streams survived a real rolling update', note: 'run twice, zero broken'},
  {value: '76.8%', label: 'Line coverage, 4 core modules', note: 'JaCoCo, unit + integration'},
];

const FEATURES: {title: string; icon: string; body: string}[] = [
  {
    title: 'Routing and failover',
    icon: 'route',
    body: `Circuit breakers, retries, and bulkheads across multiple providers (Ollama, Groq, Gemini, or any
      OpenAI-compatible endpoint) &ndash; a failing provider doesn't take your application down with it. See
      <a href="${base}/docs/adr/circuit-breaker-state-local-with-redis-advisory-hint/">why breaker state is local, not shared</a>.`,
  },
  {
    title: 'Semantic caching',
    icon: 'cache',
    body: `Near-duplicate prompts are served from a vector cache (Postgres + pgvector) instead of hitting a provider
      again, with a guard against false hits. See
      <a href="${base}/docs/design/cache-correctness/">how the false-hit rate is actually measured</a>.`,
  },
  {
    title: 'Quota enforcement',
    icon: 'gauge',
    body: 'Per-API-key rate limits, concurrency caps, and monthly token budgets, checked and reserved atomically before a request is ever dispatched &ndash; not after the fact.',
  },
  {
    title: 'Cost accounting',
    icon: 'ledger',
    body: 'Every request&rsquo;s real (or avoided, on a cache hit) cost, computed from a configurable per-model price sheet and exposed in response headers, the request log, and a Grafana dashboard.',
  },
  {
    title: 'Versioned prompt registry',
    icon: 'tag',
    body: 'Name a prompt, version it, and roll a production alias back to a previous version on the next request &ndash; no gateway restart, no redeploy.',
  },
  {
    title: 'Kubernetes-proven',
    icon: 'k8s',
    body: `Graceful SSE drain under a real rolling update, in-flight-stream-based autoscaling, not CPU. See
      <a href="${base}/docs/design/kubernetes-deployment/">the graceful-drain chain in detail</a>.`,
  },
];

const ICONS: Record<string, string> = {
  route:
    '<path d="M4 6h6a4 4 0 0 1 4 4 4 4 0 0 0 4 4h2"/><circle cx="4" cy="6" r="1.6"/><circle cx="20" cy="14" r="1.6"/><path d="M4 18h4l3-3"/><circle cx="4" cy="18" r="1.6"/>',
  cache:
    '<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/><path d="M5 11.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/>',
  gauge:
    '<path d="M4 15a8 8 0 1 1 16 0"/><path d="M12 15 16 9"/><circle cx="12" cy="15" r="1.3"/>',
  ledger:
    '<rect x="5" y="3.5" width="14" height="17" rx="1.5"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4"/>',
  tag: '<path d="M11.5 4H6a1.5 1.5 0 0 0-1.5 1.5V11c0 .4.16.78.44 1.06l8 8a1.5 1.5 0 0 0 2.12 0l5-5a1.5 1.5 0 0 0 0-2.12l-8-8A1.5 1.5 0 0 0 11.5 4Z"/><circle cx="8.5" cy="8.5" r="1.3"/>',
  k8s: '<path d="M12 3.5 19.5 8v8L12 20.5 4.5 16V8Z"/><path d="M12 3.5v17M4.5 8l7.5 4.5M19.5 8 12 12.5M4.5 16l7.5-4.5M19.5 16 12 12.5"/>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aether Gateway</title>
    <meta
      name="description"
      content="A self-hosted LLM gateway - streaming proxy, multi-provider failover, and vector-based semantic caching, measured against a reproducible load-test harness."
    />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <meta property="og:image" content={`${base}/img/social-card.jpg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="kicker"><span class="dot" aria-hidden="true"></span>Self-hosted LLM gateway</span>
          <h1 class="hero-title">Aether Gateway</h1>
          <p class="hero-lede">
            Point an existing OpenAI-compatible SDK at Aether instead of at a provider directly. It handles routing,
            failover, semantic caching, quota enforcement, cost accounting, and observability transparently &ndash;
            measured to cut cache-hit latency to <code>8.9ms p95</code> and fail over to a healthy provider in{' '}
            <code>67.92ms p99</code>, both against a reproducible load-test harness, not estimates.
          </p>
          <div class="cta-row">
            <a class="button button-primary" href={`${base}/docs/getting-started/`}>Get started &rarr;</a>
            <a class="button button-outline" href={`${base}/docs/usage/`}>Usage guide</a>
            <a class="button button-outline" href="https://github.com/Ashish-CodeJourney/aether-gateway">View source</a>
          </div>
        </div>

        <div class="trace-panel" role="img" aria-label="Diagram of a request routed from client through Aether Gateway to a provider, with the response cached">
          <div class="trace-eyebrow">live request trace</div>
          <svg class="trace-svg" viewBox="0 0 320 140" fill="none" aria-hidden="true">
            <path class="trace-line" d="M28 40 H140 Q160 40 160 60 V80 Q160 100 180 100 H292" />
            <circle class="trace-dot" r="4" />
            <g class="trace-node">
              <circle cx="28" cy="40" r="9" />
              <text x="28" y="63">client</text>
            </g>
            <g class="trace-node">
              <circle cx="160" cy="70" r="9" />
              <text x="160" y="93">aether</text>
            </g>
            <g class="trace-node">
              <circle cx="292" cy="100" r="9" />
              <text x="292" y="123">provider</text>
            </g>
          </svg>
          <div class="trace-readout" aria-hidden="true">
            <div class="trace-line-1">
              <span class="trace-frame trace-frame-1">X-Aether-Cache: <b>MISS</b></span>
              <span class="trace-frame trace-frame-2">X-Aether-Cache: <b class="hit">EXACT_HIT</b></span>
            </div>
            <div class="trace-line-2">
              <span class="trace-frame trace-frame-1">X-Aether-Cost-USD: 0.0000195</span>
              <span class="trace-frame trace-frame-2">X-Aether-Cost-USD: <b class="hit">0</b></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section class="section reveal">
        <div class="container">
          <h2 class="section-title">Measured, not estimated</h2>
          <p class="section-lede">
            Every number here is reproducible via <code>make bench</code> against a real running stack &ndash; full
            methodology and raw data in{' '}
            <a href="https://github.com/Ashish-CodeJourney/aether-gateway/blob/trunk/BENCHMARKS.md">BENCHMARKS.md</a>.
          </p>
          <div class="stat-grid">
            {
              STATS.map((stat) => (
                <div class="stat-card">
                  <div class="stat-value">{stat.value}</div>
                  <div class="stat-label">{stat.label}</div>
                  {stat.note && <div class="stat-note">{stat.note}</div>}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-alt reveal">
        <div class="container">
          <h2 class="section-title">What actually happens on a request</h2>
          <p class="section-lede">
            The response headers tell you exactly what the gateway did &ndash; no guessing whether a request was
            served from cache or which provider actually answered it.
          </p>
          <div class="demo-layout">
            <pre class="demo-code"><code>{`$ curl -X POST http://localhost:8080/v1/chat/completions \\
    -H "Content-Type: application/json" \\
    -d '{"model":"mock","messages":[{"role":"user","content":"What is 2+2?"}]}' -D -

HTTP/1.1 200 OK
X-Aether-Cache: MISS
X-Aether-Cost-USD: 0.0000195
X-Aether-Attempts: 1
X-Aether-Provider: mock-primary`}</code></pre>
            <div class="demo-note">
              <p>Same prompt, sent again:</p>
              <ul>
                <li><code>X-Aether-Cache: EXACT_HIT</code> &ndash; served from the semantic cache, <code>X-Aether-Cost-USD: 0</code></li>
              </ul>
              <p>Force the primary provider to fail, then send a new prompt:</p>
              <ul>
                <li><code>X-Aether-Provider: mock-fallback</code> &ndash; failover happened, same request shape, no client change</li>
              </ul>
              <p>
                This is a real transcript from a real <code>docker compose up</code>, not a mockup &ndash; see the{' '}
                <a href={`${base}/docs/getting-started/`}>Getting Started guide</a> to reproduce it yourself in under a minute.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="section reveal">
        <div class="container">
          <h2 class="section-title">What it does</h2>
          <p class="section-lede">
            The engineering value isn't in calling models &ndash; it's in everything around the call. Six things it
            actually handles for you:
          </p>
          <div class="feature-grid">
            {
              FEATURES.map((feature) => (
                <div class="feature-card">
                  <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[feature.icon]} />
                  <div class="feature-title">{feature.title}</div>
                  <div class="feature-body" set:html={feature.body} />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="final-cta reveal">
        <div class="container">
          <h2 class="final-cta-title">Bring up the whole stack in one command</h2>
          <p class="final-cta-lede">
            Gateway, Postgres+pgvector, Redis, two mock providers, Prometheus, and a pre-provisioned Grafana
            dashboard &ndash; seeded and ready, no manual setup.
          </p>
          <div class="cta-row cta-row-center">
            <a class="button button-primary" href={`${base}/docs/getting-started/`}>Getting Started guide &rarr;</a>
            <a class="button button-outline" href={`${base}/docs/`}>Browse the docs</a>
          </div>
        </div>
      </section>

      <footer class="site-footer">
        <div class="container footer-grid">
          <div>
            <div class="footer-title">Get started</div>
            <ul>
              <li><a href={`${base}/docs/getting-started/`}>Getting Started</a></li>
              <li><a href={`${base}/docs/usage/`}>Usage Guide</a></li>
              <li><a href="https://github.com/Ashish-CodeJourney/aether-gateway#readme">README</a></li>
              <li><a href="https://github.com/Ashish-CodeJourney/aether-gateway/blob/trunk/BENCHMARKS.md">Benchmarks</a></li>
            </ul>
          </div>
          <div>
            <div class="footer-title">Design</div>
            <ul>
              <li><a href={`${base}/docs/adr/hexagonal-module-layout/`}>Architecture Decision Records</a></li>
              <li><a href={`${base}/docs/design/api-contract/`}>Design docs</a></li>
            </ul>
          </div>
          <div>
            <div class="footer-title">Project</div>
            <ul>
              <li><a href="https://github.com/Ashish-CodeJourney/aether-gateway/blob/trunk/CONTRIBUTING.md">Contributing</a></li>
              <li><a href="https://github.com/Ashish-CodeJourney/aether-gateway/blob/trunk/SECURITY.md">Security policy</a></li>
              <li><a href="https://github.com/Ashish-CodeJourney/aether-gateway/blob/trunk/LICENSE">MIT License</a></li>
            </ul>
          </div>
        </div>
        <div class="container footer-copyright">
          Aether Gateway &ndash; built to production standards. Docs built with Astro + Starlight.
        </div>
      </footer>
    </main>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              io.unobserve(entry.target);
            }
          }
        },
        {threshold: 0.12},
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <style>
      :root {
        --font-display: 'Space Grotesk', 'Segoe UI', sans-serif;
        --font-body: 'Inter', 'Segoe UI', sans-serif;
        --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;

        --accent: #6e56cf;
        --accent-2: #d97706;
        --accent-3: #0f9d8c;
        --text: #1c1730;
        --text-dim: #5b5470;
        --border: rgba(76, 45, 158, 0.14);
        --bg: #faf9fc;
        --bg-alt: #f1eef9;
        --panel: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --accent: #ab9ff2;
          --accent-2: #fbbf24;
          --accent-3: #35d6b8;
          --text: #f1eefc;
          --text-dim: #b3a9d6;
          --border: rgba(171, 159, 242, 0.16);
          --bg: #0e0b16;
          --bg-alt: #161225;
          --panel: #1a1530;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }

      :global(html) {
        font-family: var(--font-body);
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
      }
      h1,
      h2 {
        font-family: var(--font-display);
        color: var(--text);
      }
      .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      code,
      pre {
        font-family: var(--font-mono);
      }
      a {
        color: var(--accent);
      }

      /* ---- hero ---- */
      .hero {
        padding: 5.5rem 0 4.5rem;
        background: radial-gradient(ellipse 70% 60% at 15% -10%, rgba(110, 86, 207, 0.22), transparent), var(--bg);
        overflow: hidden;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
        gap: 3rem;
        align-items: center;
      }
      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: 1fr;
        }
      }
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.1rem;
      }
      .kicker .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent-3);
        box-shadow: 0 0 0 0 rgba(15, 157, 140, 0.5);
        animation: pulse 2.2s ease-out infinite;
      }
      @keyframes pulse {
        0% {
          box-shadow: 0 0 0 0 rgba(15, 157, 140, 0.45);
        }
        70% {
          box-shadow: 0 0 0 7px rgba(15, 157, 140, 0);
        }
        100% {
          box-shadow: 0 0 0 0 rgba(15, 157, 140, 0);
        }
      }
      .hero-title {
        font-size: 3.1rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 1.25rem;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 130%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .hero-lede {
        font-size: 1.2rem;
        line-height: 1.6;
        color: var(--text-dim);
        margin: 0 0 2rem;
        max-width: 620px;
      }
      .hero-lede code {
        font-size: 0.85em;
        color: var(--text);
      }

      .cta-row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .cta-row-center {
        justify-content: center;
      }
      .button {
        display: inline-block;
        padding: 0.7rem 1.4rem;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        transition: transform 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
      }
      .button:hover {
        transform: translateY(-1px);
      }
      .button-primary {
        background: var(--accent);
        color: white;
      }
      .button-primary:hover {
        opacity: 0.92;
      }
      .button-outline {
        border-color: var(--border);
        color: var(--accent);
      }
      .button-outline:hover {
        border-color: var(--accent);
      }

      /* ---- signature: live request trace ---- */
      .trace-panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.25rem 1.25rem 1.5rem;
        box-shadow: 0 20px 44px -28px rgba(76, 45, 158, 0.35);
      }
      .trace-eyebrow {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-dim);
        margin-bottom: 0.5rem;
      }
      .trace-svg {
        width: 100%;
        height: auto;
        overflow: visible;
      }
      .trace-line {
        fill: none;
        stroke: var(--border);
        stroke-width: 2;
        stroke-dasharray: 4 5;
      }
      .trace-node circle {
        fill: var(--bg);
        stroke: var(--accent);
        stroke-width: 2;
      }
      .trace-node text {
        font-family: var(--font-mono);
        font-size: 9px;
        fill: var(--text-dim);
        text-anchor: middle;
      }
      .trace-dot {
        fill: var(--accent-3);
        offset-path: path('M28 40 H140 Q160 40 160 60 V80 Q160 100 180 100 H292');
        animation: travel 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      @keyframes travel {
        0% {
          offset-distance: 0%;
          opacity: 0;
        }
        6% {
          opacity: 1;
        }
        46% {
          offset-distance: 100%;
          opacity: 1;
        }
        52% {
          opacity: 0;
        }
        100% {
          offset-distance: 100%;
          opacity: 0;
        }
      }
      .trace-readout {
        margin-top: 1rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--text-dim);
        border-top: 1px dashed var(--border);
        padding-top: 0.85rem;
      }
      .trace-line-1,
      .trace-line-2 {
        position: relative;
        height: 1.3em;
        overflow: hidden;
      }
      .trace-line-2 {
        margin-top: 0.3em;
      }
      .trace-frame {
        position: absolute;
        inset: 0;
        opacity: 0;
        animation: crossfade 6.4s ease-in-out infinite;
      }
      .trace-frame b {
        color: var(--text);
        font-weight: 600;
      }
      .trace-frame b.hit {
        color: var(--accent-3);
      }
      .trace-frame-1 {
        animation-delay: 0s;
      }
      .trace-frame-2 {
        animation-delay: 0s;
        animation-name: crossfade-2;
      }
      @keyframes crossfade {
        0%,
        44% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }
      @keyframes crossfade-2 {
        0%,
        44% {
          opacity: 0;
        }
        50%,
        94% {
          opacity: 1;
        }
        100% {
          opacity: 0;
        }
      }

      /* ---- reveal-on-scroll ---- */
      .reveal {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }
      .reveal.in-view {
        opacity: 1;
        transform: none;
      }

      /* ---- sections ---- */
      .section {
        padding: 3.75rem 0;
      }
      .section-alt {
        background: var(--bg-alt);
      }
      .section-title {
        font-size: 1.65rem;
        font-weight: 600;
        margin: 0 0 0.5rem;
      }
      .section-lede {
        color: var(--text-dim);
        margin: 0 0 2rem;
        max-width: 680px;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
      }
      @media (max-width: 900px) {
        .stat-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      .stat-card {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.25rem 1.25rem 1.1rem;
        background: var(--panel);
        transition: border-color 0.15s ease, transform 0.15s ease;
      }
      .stat-card:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
      }
      .stat-value {
        font-family: var(--font-display);
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: -0.02em;
        line-height: 1.1;
      }
      .stat-label {
        font-size: 0.87rem;
        color: var(--text-dim);
        margin-top: 0.4rem;
      }
      .stat-note {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-dim);
        opacity: 0.75;
        margin-top: 0.55rem;
      }

      .demo-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: start;
      }
      @media (max-width: 900px) {
        .demo-layout {
          grid-template-columns: 1fr;
        }
      }
      .demo-code {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1rem;
        overflow-x: auto;
        font-size: 0.83rem;
        background: var(--panel);
        margin: 0;
      }
      .demo-note {
        font-size: 0.92rem;
        color: var(--text-dim);
        line-height: 1.6;
      }
      .demo-note p {
        margin: 0.9rem 0 0;
      }
      .demo-note p:first-child {
        margin-top: 0;
      }
      .demo-note ul {
        margin: 0.6rem 0 0;
