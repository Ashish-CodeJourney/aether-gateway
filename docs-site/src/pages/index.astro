---
// `trailingSlash: 'never'` (astro.config.mjs) also strips BASE_URL's own
// trailing slash, so every link below explicitly joins with `/`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const REPO = 'https://github.com/Ashish-CodeJourney/aether-gateway';
const BLOB = `${REPO}/blob/trunk`;
const SITE = `https://ashish-codejourney.github.io${base}`;

const TITLE = 'Aether Gateway - one OpenAI-compatible endpoint for every LLM provider';
const DESCRIPTION =
  'Free, open-source, self-hosted LLM gateway. Point any OpenAI SDK at it and get multi-provider failover, exact and semantic caching, per-key quotas and per-request cost tracking. MIT licensed.';

const LINKS = {
  start: `${base}/docs/getting-started/`,
  docs: `${base}/docs/`,
  usage: `${base}/docs/usage/`,
  adr: `${base}/docs/adr/hexagonal-module-layout/`,
  architecture: `${base}/docs/design/architecture-diagram/`,
  cacheCorrectness: `${base}/docs/design/cache-correctness/`,
  k8s: `${base}/docs/design/kubernetes-deployment/`,
  github: REPO,
  benchmarks: `${BLOB}/BENCHMARKS.md`,
  license: `${BLOB}/LICENSE`,
  security: `${BLOB}/SECURITY.md`,
  contributing: `${BLOB}/CONTRIBUTING.md`,
  conduct: `${BLOB}/CODE_OF_CONDUCT.md`,
};

const CODE_TABS: {id: string; label: string; html: string}[] = [
  {
    id: 'python',
    label: 'Python',
    html: `<span class="t-k">from</span> openai <span class="t-k">import</span> OpenAI

client = <span class="t-f">OpenAI</span>(
<mark>    base_url=<span class="t-s">"http://localhost:8080/v1"</span>,</mark>
<mark>    api_key=<span class="t-s">"your-aether-key"</span>,</mark>
)

reply = client.chat.completions.<span class="t-f">create</span>(
    model=<span class="t-s">"mock"</span>,
    messages=[{<span class="t-s">"role"</span>: <span class="t-s">"user"</span>, <span class="t-s">"content"</span>: <span class="t-s">"What is 2+2?"</span>}],
)`,
  },
  {
    id: 'typescript',
    label: 'TypeScript',
    html: `<span class="t-k">import</span> OpenAI <span class="t-k">from</span> <span class="t-s">"openai"</span>;

<span class="t-k">const</span> client = <span class="t-k">new</span> <span class="t-f">OpenAI</span>({
<mark>  baseURL: <span class="t-s">"http://localhost:8080/v1"</span>,</mark>
<mark>  apiKey: process.env.AETHER_API_KEY,</mark>
});

<span class="t-k">const</span> reply = <span class="t-k">await</span> client.chat.completions.<span class="t-f">create</span>({
  model: <span class="t-s">"mock"</span>,
  messages: [{ role: <span class="t-s">"user"</span>, content: <span class="t-s">"What is 2+2?"</span> }],
});`,
  },
  {
    id: 'curl',
    label: 'curl',
    html: `<span class="t-f">curl</span> http://localhost:8080/v1/chat/completions \\
<mark>  -H <span class="t-s">"Authorization: Bearer $AETHER_API_KEY"</span> \\</mark>
  -H <span class="t-s">"Content-Type: application/json"</span> \\
  -d <span class="t-s">'{"model":"mock","messages":[
        {"role":"user","content":"What is 2+2?"}]}'</span>`,
  },
];

const PROVIDERS: {name: string; mono: string}[] = [
  {name: 'Ollama', mono: 'Ol'},
  {name: 'Groq', mono: 'Gq'},
  {name: 'Google Gemini', mono: 'Ge'},
  {name: 'Anthropic', mono: 'An'},
  {name: 'Any OpenAI-compatible API', mono: '{ }'},
];

const STATS: {value: string; unit: string; label: string; detail: string}[] = [
  {value: '8.9', unit: 'ms', label: 'Cache-hit latency', detail: 'p95, end to end'},
  {value: '67.92', unit: 'ms', label: 'Failover to a healthy provider', detail: 'p99 across 100 injected outages'},
  {value: '500', unit: '/500', label: 'Streams survived a rolling update', detail: 'Kubernetes, run twice, zero broken'},
  {value: '7.23', unit: 'ms', label: 'Prompt embedding for semantic cache', detail: 'mean, all-MiniLM-L6-v2'},
];

const FEATURES: {title: string; icon: string; body: string}[] = [
  {
    title: 'Automatic failover',
    icon: 'route',
    body: 'Circuit breakers, retries and bulkheads move traffic to the next provider in the chain, so a provider outage never becomes your outage.',
  },
  {
    title: 'Exact + semantic caching',
    icon: 'cache',
    body: 'Repeat and near-duplicate prompts are answered from Postgres + pgvector, with an entity and number guard so &ldquo;2+2&rdquo; never answers &ldquo;2+3&rdquo;.',
  },
  {
    title: 'Quotas per API key',
    icon: 'gauge',
    body: 'Rate limits, concurrency caps and monthly token budgets are reserved atomically in Redis before a request reaches a provider.',
  },
  {
    title: 'Cost on every response',
    icon: 'ledger',
    body: '<code>X-Aether-Cost-USD</code>, <code>X-Aether-Provider</code> and <code>X-Aether-Cache</code> tell you what a call cost, who served it and whether it hit cache.',
  },
  {
    title: 'Streaming that stops when users leave',
    icon: 'stream',
    body: 'SSE responses relay token by token, and a client disconnect cancels the upstream call, so you stop paying for tokens nobody will read.',
  },
  {
    title: 'Observability out of the box',
    icon: 'chart',
    body: 'Prometheus metrics plus a ready-made Grafana dashboard: latency by provider, cache hit rate, spend vs. spend avoided, breaker state.',
  },
  {
    title: 'Operator console',
    icon: 'console',
    body: 'Issue and revoke API keys, version prompts and roll them back, watch cache stats and search the request log from one UI.',
  },
  {
    title: 'Kubernetes-ready',
    icon: 'k8s',
    body: 'Plain manifests with graceful SSE drain, a PodDisruptionBudget and a NetworkPolicy, proven against a real zero-downtime rolling update.',
  },
];

const ICONS: Record<string, string> = {
  route:
    '<path d="M4 6h6a4 4 0 0 1 4 4 4 4 0 0 0 4 4h2"/><circle cx="4" cy="6" r="1.6"/><circle cx="20" cy="14" r="1.6"/><path d="M4 18h4l3-3"/><circle cx="4" cy="18" r="1.6"/>',
  cache:
    '<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/><path d="M5 11.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/>',
  gauge: '<path d="M4 15a8 8 0 1 1 16 0"/><path d="M12 15 16 9"/><circle cx="12" cy="15" r="1.3"/>',
  ledger: '<rect x="5" y="3.5" width="14" height="17" rx="1.5"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4"/>',
  stream: '<path d="M3 8h10M3 12h14M3 16h7"/><path d="m17 14 4 4m0-4-4 4"/>',
  chart: '<path d="M4 4v16h16"/><path d="m7 15 4-5 3 3 5-6"/>',
  console: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 9h18M7 13h4M7 16h7"/>',
  k8s: '<path d="M12 3.5 19.5 8v8L12 20.5 4.5 16V8Z"/><path d="M12 3.5v17M4.5 8l7.5 4.5M19.5 8 12 12.5M4.5 16l7.5-4.5M19.5 16 12 12.5"/>',
};

const FLOW: {title: string; body: string; infra: string}[] = [
  {title: 'Authenticate', body: 'API key resolves to its own limits and budget.', infra: 'Postgres'},
  {title: 'Enforce quota', body: 'Token bucket and budget reserved atomically.', infra: 'Redis'},
  {title: 'Check cache', body: 'Exact match first, then semantic nearest neighbour.', infra: 'pgvector'},
  {title: 'Route & fail over', body: 'Policy picks a provider chain; breakers skip the unhealthy.', infra: 'routing.yaml'},
  {title: 'Stream', body: 'SSE relayed as it arrives; disconnect cancels upstream.', infra: 'WebFlux'},
  {title: 'Account', body: 'Tokens, cost, cache write and metrics, off the hot path.', infra: 'Prometheus'},
];

const COMPARE_COLUMNS = ['Aether Gateway', 'LiteLLM', 'Portkey Gateway', 'Build your own'];
const COMPARE_ROWS: {label: string; cells: string[]}[] = [
  {
    label: 'Runtime',
    cells: ['Java 25 · Spring Boot 4.1 (JVM)', 'Python', 'TypeScript', 'Your stack'],
  },
  {
    label: 'License',
    cells: ['MIT, no paid edition', 'MIT core, enterprise features licensed separately', 'MIT gateway, managed platform available', 'Yours'],
  },
  {
    label: 'Self-hosting',
    cells: [
      'One <code>docker compose</code> stack: gateway, Postgres + pgvector, Redis, Prometheus, Grafana',
      'Supported',
      'Supported',
      'You design, build and operate it',
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#0c0a14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfaff" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:image" content={`${SITE}/img/social-card.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE}/img/social-card.jpg`} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('starlight-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href={`${base}/`} aria-label="Aether Gateway home">
          <img src={`${base}/img/logo.svg`} alt="" width="28" height="28" />
          <span>Aether Gateway</span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            <li class="nav-hide-sm"><a href={LINKS.docs}>Docs</a></li>
            <li class="nav-hide-sm"><a href="#benchmarks">Benchmarks</a></li>
            <li class="nav-hide-sm"><a href="#compare">Compare</a></li>
            <li>
              <a class="nav-icon" href={LINKS.github} aria-label="Aether Gateway on GitHub">
                <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor"
                  ><path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  ></path></svg
                >
              </a>
            </li>
            <li><a class="button button-primary button-sm" href={LINKS.start}>Get started</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <a class="pill" href={LINKS.license}>
              <span class="pill-dot" aria-hidden="true"></span>
              Free &amp; open source <span aria-hidden="true">·</span> MIT licensed
            </a>
            <h1 id="hero-title" class="hero-title">
              One endpoint for <span class="grad">every LLM provider.</span>
            </h1>
            <p class="hero-lede">
              Aether is a self-hosted gateway that speaks the OpenAI API. Point the SDK you already use at it and get
              automatic failover, exact and semantic caching, per-key quotas and per-request cost tracking &ndash; with
              no changes to your application code.
            </p>
            <div class="cta-row">
              <a class="button button-primary" href={LINKS.start}>
                Get started <span aria-hidden="true">&rarr;</span>
              </a>
              <a class="button button-ghost" href={LINKS.github}>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"
                  ><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8L3.5 9.7l5.9-.9Z"></path></svg
                >
                Star on GitHub
              </a>
            </div>
            <div class="quickstart">
              <span class="quickstart-label">Quickstart</span>
              <code><span class="prompt" aria-hidden="true">$</span> docker compose up -d</code>
            </div>
            <p class="hero-meta">Self-hosted · Java 25 / Spring Boot 4.1 · Docker Compose &amp; Kubernetes</p>
          </div>

          <div class="code-window" aria-label="Switching an OpenAI client to Aether Gateway">
            {
              CODE_TABS.map((tab, i) => (
                <input class="tab-input" type="radio" name="code-lang" id={`tab-${tab.id}`} checked={i === 0} />
              ))
            }
            <div class="code-bar">
              <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <div class="tab-labels">
                {CODE_TABS.map((tab) => <label for={`tab-${tab.id}`} data-tab={tab.id}>{tab.label}</label>)}
              </div>
            </div>
            <div class="code-panels">
              {
                CODE_TABS.map((tab) => (
                  <pre class="code-panel" data-tab={tab.id}><code set:html={tab.html} /></pre>
                ))
              }
            </div>
            <div class="code-response" aria-label="Response headers">
              <div class="code-response-title">Response headers</div>
              <pre><code><span class="t-dim">HTTP/1.1 200 OK</span>
X-Aether-Provider: <span class="t-ok">mock-primary</span>
X-Aether-Cache: <span class="t-ok">MISS</span>
X-Aether-Cost-USD: <span class="t-ok">0.0000195</span></code></pre>
            </div>
          </div>
        </div>
      </section>

      <section class="providers" aria-labelledby="providers-title">
        <div class="container providers-inner">
          <h2 id="providers-title" class="providers-title">Routes to</h2>
          <ul class="provider-list">
            {
              PROVIDERS.map((p) => (
                <li class="provider">
                  <span class="provider-mono" aria-hidden="true">{p.mono}</span>
                  {p.name}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="benchmarks" class="section stats" aria-labelledby="stats-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Benchmarks</p>
            <h2 id="stats-title" class="section-title">Measured, not estimated.</h2>
            <p class="section-lede">
              Every number comes from a committed run against the real stack. The harness, raw CSVs and methodology are
              in the repository &ndash; reproduce them with <code>make bench</code>.
            </p>
          </div>
          <dl class="stat-grid">
            {
              STATS.map((s) => (
                <div class="stat">
                  <dt class="stat-label">{s.label}</dt>
                  <dd class="stat-value">
                    {s.value}
                    <span class="stat-unit">{s.unit}</span>
                  </dd>
                  <dd class="stat-detail">{s.detail}</dd>
                </div>
              ))
            }
          </dl>
          <p class="section-link">
            <a href={LINKS.benchmarks}>Read the full benchmark report <span aria-hidden="true">&rarr;</span></a>
          </p>
        </div>
      </section>

      <section class="section" aria-labelledby="features-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Features</p>
            <h2 id="features-title" class="section-title">Everything around the model call.</h2>
            <p class="section-lede">
              Calling a model is one line. Keeping it fast, affordable and up when a provider is not is the hard part &ndash;
              that is what Aether does.
            </p>
          </div>
          <ul class="feature-grid">
            {
              FEATURES.map((f) => (
                <li class="feature">
                  <svg
                    class="feature-icon"
                    viewBox="0 0 24 24"
                    width="22"
                    height="22"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={ICONS[f.icon]}
                  />
                  <h3 class="feature-title">{f.title}</h3>
                  <p class="feature-body" set:html={f.body} />
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section section-alt" aria-labelledby="flow-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">How it works</p>
            <h2 id="flow-title" class="section-title">One request, six steps, one response.</h2>
            <p class="section-lede">
              Your application sends a normal OpenAI request. Aether runs it through the same pipeline every time and
              tells you what happened in the response headers.
            </p>
          </div>

          <div class="flow">
            <div class="flow-end flow-client">
              <span class="flow-end-label">Your app</span>
              <span class="flow-end-sub">any OpenAI SDK</span>
            </div>
            <div class="flow-pipeline">
              <div class="flow-bypass" aria-hidden="true"><span>cache hit: skip the provider, cost $0</span></div>
              <ol class="flow-steps">
                {
                  FLOW.map((step, i) => (
                    <li class="flow-step">
                      <span class="flow-num" aria-hidden="true">{i + 1}</span>
                      <h3 class="flow-title">{step.title}</h3>
                      <p class="flow-body">{step.body}</p>
                      <span class="flow-infra">{step.infra}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
            <div class="flow-end flow-providers">
              <span class="flow-end-label">Providers</span>
              <span class="flow-end-sub">Ollama · Groq · Gemini · Anthropic · OpenAI-compatible</span>
            </div>
          </div>
          <p class="flow-note">
            On a cache hit, steps 4 and 5 are skipped entirely &ndash; the response comes back with
            <code>X-Aether-Cache: EXACT_HIT</code> or <code>SEMANTIC_HIT</code> and <code>X-Aether-Cost-USD: 0</code>.
            <a href={LINKS.architecture}>See the full architecture</a>.
          </p>
        </div>
      </section>

      <section id="compare" class="section" aria-labelledby="compare-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Compare</p>
            <h2 id="compare-title" class="section-title">Where Aether fits.</h2>
            <p class="section-lede">
              There are good LLM gateways already. Here is an honest look at how Aether differs, so you can pick the
              right one.
            </p>
          </div>
          <div class="table-wrap" role="region" aria-labelledby="compare-title" tabindex="0">
            <table class="compare">
              <thead>
                <tr>
                  <td></td>
                  {COMPARE_COLUMNS.map((c, i) => <th scope="col" class={i === 0 ? 'is-us' : undefined}>{c}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  COMPARE_ROWS.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      {row.cells.map((cell, i) => (
                        <td class={i === 0 ? 'is-us' : undefined} set:html={cell} />
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="fit-grid">
            <div class="fit fit-yes">
              <h3>Aether is a good fit if you&hellip;</h3>
              <ul>
                <li>run on the JVM, or want a gateway your Java team can read and extend</li>
                <li>want one self-hosted stack with caching, quotas, metrics and dashboards included</li>
                <li>want performance numbers you can reproduce yourself, not just read</li>
                <li>need a plain MIT license with no paid edition</li>
              </ul>
            </div>
            <div class="fit fit-no">
              <h3>Look elsewhere if you&hellip;</h3>
              <ul>
                <li>need the widest provider catalogue today &ndash; LiteLLM and Portkey support many more</li>
                <li>want a fully managed, hosted service instead of running your own</li>
                <li>want an in-process Python library rather than a network gateway</li>
              </ul>
            </div>
          </div>
          <p class="footnote">
            Details about other projects are summarised from their public repositories and may change; check their
            documentation for current status.
          </p>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="cta-title">
        <div class="container final-cta-inner">
          <div>
            <h2 id="cta-title" class="final-cta-title">Your first request is a minute away.</h2>
            <p class="final-cta-lede">
              One command brings up the gateway, Postgres + pgvector, Redis, two mock providers for failover demos,
              Prometheus and Grafana &ndash; seeded and ready.
            </p>
            <div class="cta-row">
              <a class="button button-primary" href={LINKS.start}>
                Get started <span aria-hidden="true">&rarr;</span>
              </a>
              <a class="button button-ghost" href={LINKS.github}>Star on GitHub</a>
            </div>
          </div>
          <pre class="terminal" aria-label="Quickstart commands"><code><span class="t-dim">$</span> git clone {REPO}.git
<span class="t-dim">$</span> cd aether-gateway
<span class="t-dim">$</span> docker compose up -d
<span class="t-dim"># gateway on :8080 · Grafana on :3000</span></code></pre>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href={`${base}/`}>
            <img src={`${base}/img/logo.svg`} alt="" width="24" height="24" />
            <span>Aether Gateway</span>
          </a>
          <p>A free, open-source, self-hosted LLM gateway. Released under the MIT License.</p>
        </div>
        <nav aria-label="Documentation">
          <h2 class="footer-title">Docs</h2>
          <ul>
            <li><a href={LINKS.docs}>Introduction</a></li>
            <li><a href={LINKS.start}>Getting started</a></li>
            <li><a href={LINKS.usage}>Usage guide</a></li>
