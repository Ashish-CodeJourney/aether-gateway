        font-variant-numeric: tabular-nums;
      }
      .stat-num {
        background: linear-gradient(100deg, #0e7490, #2563eb);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .stat-unit {
        font-size: 0.45em;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-left: 0.2em;
        color: var(--muted);
      }
      .stat-detail {
        order: 3;
        margin: 0.25rem 0 0;
        font-size: 0.86rem;
        color: var(--muted);
      }
      @media (max-width: 960px) {
        .stat-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (max-width: 480px) {
        .stat-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---- features ---- */
      .feature-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      @media (max-width: 1080px) {
        .feature-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (max-width: 600px) {
        .feature-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      .feature {
        position: relative;
        padding: 1.6rem 1.5rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: #ffffff;
        box-shadow: var(--shadow-sm);
      }
      .js .feature.reveal,
      .feature {
        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease,
          border-color 0.25s ease,
          opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms);
      }
      .feature:hover,
      .js .feature.reveal.is-in:hover {
        transform: translateY(-4px);
        border-color: #a5e9f5;
        box-shadow: var(--shadow-md);
      }
      .feature-icon {
        display: inline-grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 12px;
        background: linear-gradient(135deg, #cff5fb, #dce8ff);
        color: var(--teal-800);
        margin-bottom: 1.1rem;
        transition: transform 0.25s ease;
      }
      .feature:hover .feature-icon {
        transform: rotate(-6deg) scale(1.06);
      }
      .feature-title {
        font-size: 1.06rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-bottom: 0.5rem;
      }
      .feature-body {
        font-size: 0.93rem;
        color: var(--muted);
        line-height: 1.6;
      }
      .feature-body code {
        font-size: 0.8em;
      }

      /* ---- how it works ---- */
      .pipeline {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 0.9rem;
        counter-reset: step;
        position: relative;
      }
      .pipeline::before {
        content: '';
        position: absolute;
        left: 2%;
        right: 2%;
        top: 1.55rem;
        height: 2px;
        background: linear-gradient(90deg, #cff5fb, #22d3ee, #2563eb, #dce8ff);
        opacity: 0.7;
      }
      .pipe-step {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 0 0.15rem;
      }
      .pipe-num {
        display: inline-grid;
        place-items: center;
        width: 3.1rem;
        height: 3.1rem;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid #a5e9f5;
        color: var(--teal);
        font-family: var(--font-mono);
        font-size: 0.86rem;
        font-weight: 600;
        margin-bottom: 1rem;
        box-shadow: 0 0 0 6px #ffffff;
      }
      .pipe-step:nth-child(3) .pipe-num {
        border-color: #34d399;
        color: var(--ok);
      }
      .pipe-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
      }
      .pipe-body {
        font-size: 0.88rem;
        color: var(--muted);
        line-height: 1.5;
        flex: 1;
      }
      .pipe-infra {
        align-self: flex-start;
        margin-top: 0.8rem;
        padding: 0.12rem 0.5rem;
        border-radius: 6px;
        background: var(--tint-2);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--teal-800);
      }
      @media (max-width: 980px) {
        .pipeline {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          row-gap: 2rem;
        }
        .pipeline::before {
          display: none;
        }
      }
      @media (max-width: 560px) {
        .pipeline {
          grid-template-columns: minmax(0, 1fr);
          row-gap: 1.25rem;
        }
        .pipe-step {
          display: grid;
          grid-template-columns: 3.1rem minmax(0, 1fr);
          column-gap: 1rem;
        }
        .pipe-num {
          grid-row: span 3;
          margin: 0;
        }
      }

      /* ---- compare ---- */
      .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: #ffffff;
        box-shadow: var(--shadow-sm);
      }
      .compare {
        width: 100%;
        min-width: 720px;
        border-collapse: collapse;
        font-size: 0.93rem;
      }
      .compare th,
      .compare td {
        padding: 1rem 1.1rem;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--border);
      }
      .compare tbody tr:last-child > * {
        border-bottom: 0;
      }
      .compare thead th {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
      }
      .compare tbody th {
        font-weight: 600;
        color: var(--muted);
        white-space: nowrap;
        width: 9rem;
      }
      .compare td {
        color: var(--muted);
      }
      .compare .is-us {
        background: linear-gradient(180deg, rgba(207, 245, 251, 0.45), rgba(220, 232, 255, 0.35));
        color: var(--ink);
        width: 28%;
      }
      .compare thead .is-us {
        color: var(--teal);
      }
      .fit-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }
      @media (max-width: 760px) {
        .fit-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      .fit {
        padding: 1.5rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: #ffffff;
        box-shadow: var(--shadow-sm);
      }
      .fit h3 {
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 0.85rem;
      }
      .fit ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.6rem;
      }
      .fit li {
        position: relative;
        padding-left: 1.7rem;
        color: var(--muted);
        font-size: 0.95rem;
      }
      .fit li::before {
        position: absolute;
        left: 0;
        top: 0.1rem;
        display: inline-grid;
        place-items: center;
        width: 1.15rem;
        height: 1.15rem;
        border-radius: 50%;
        font-size: 0.7rem;
        font-weight: 700;
      }
      .fit-yes li::before {
        content: '✓';
        color: var(--ok);
        background: var(--ok-soft);
      }
      .fit-no li::before {
        content: '→';
        color: var(--muted);
        background: var(--tint-2);
      }
      .footnote {
        margin-top: 1.25rem;
        font-size: 0.82rem;
        color: var(--faint);
      }

      /* ---- final CTA ---- */
      .final {
        padding: 6rem 0;
      }
      .final-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 3rem;
        align-items: center;
        padding: 3.5rem;
        border-radius: 28px;
        border: 1px solid #cfe6f3;
        background: linear-gradient(135deg, #f0fbfe 0%, #eef4ff 100%);
        box-shadow: var(--shadow-lg);
      }
      .final .blob-1 {
        width: 30rem;
        height: 22rem;
        left: -8rem;
        bottom: -10rem;
        background: radial-gradient(closest-side, #b9f0f8, rgba(185, 240, 248, 0));
        animation: drift-a 20s ease-in-out infinite alternate;
      }
      .final .blob-2 {
        width: 30rem;
        height: 22rem;
        right: -8rem;
        top: -10rem;
        background: radial-gradient(closest-side, #d3e1ff, rgba(211, 225, 255, 0));
        animation: drift-b 24s ease-in-out infinite alternate;
      }
      .final-title {
        font-size: clamp(1.9rem, 4vw, 2.75rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        margin-bottom: 0.9rem;
        text-wrap: balance;
      }
      .final-lede {
        color: var(--muted);
        font-size: 1.05rem;
        margin-bottom: 1.75rem;
        max-width: 34rem;
      }
      .final-term {
        margin: 0;
        padding: 1.4rem 1.5rem;
        border-radius: 14px;
        background: var(--code-bg);
        color: var(--code-text);
        font-size: 0.86rem;
        line-height: 1.85;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        box-shadow: var(--shadow-md);
      }
      .t-dim {
        color: var(--code-dim);
      }
      @media (max-width: 900px) {
        .final-card {
          grid-template-columns: minmax(0, 1fr);
          gap: 2rem;
          padding: 2.25rem 1.5rem;
        }
      }
      @media (max-width: 640px) {
        .final {
          padding: 4rem 0;
        }
      }

      /* ---- footer ---- */
      .footer {
        padding: 3.5rem 0 3rem;
        border-top: 1px solid var(--border);
        background: var(--tint);
        font-size: 0.93rem;
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        gap: 2rem;
      }
      @media (max-width: 760px) {
        .footer-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .footer-brand {
          grid-column: 1 / -1;
        }
      }
      .footer-brand p {
        margin-top: 0.75rem;
        color: var(--muted);
        max-width: 22rem;
      }
      .footer-title {
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
        margin-bottom: 0.8rem;
      }
      .footer ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
      }
      .footer ul a {
        color: var(--ink-2);
        text-decoration: none;
      }
      .footer ul a:hover {
        color: var(--teal);
        text-decoration: underline;
      }

      /* ---- shared demo response pane ---- */
      .h-key {
        color: #7dd3fc;
      }
      .h-val {
        color: #f1f5f9;
      }
      .h-dim {
        color: var(--code-dim);
      }
      .h-ok {
        color: #6ee7b7;
      }
      .h-bad {
        color: #fca5a5;
      }
    </style>
  </body>
</html>
