    <style is:global>
      :root {
        color-scheme: light dark;

        --font-display: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
        --font-body: 'Inter', ui-sans-serif, system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

        --bg: light-dark(#fbfaff, #0c0a14);
        --bg-alt: light-dark(#f3f0fb, #110e1c);
        --surface: light-dark(#ffffff, #16121f);
        --text: light-dark(#17132a, #f2effb);
        --muted: light-dark(#575170, #a9a2c4);
        --border: light-dark(#e4dff3, #2a2440);
        --border-strong: light-dark(#cfc7ea, #3b3359);
        --accent: light-dark(#5b43c4, #b1a5f6);
        --accent-soft: light-dark(#ece7fb, #231c3d);
        --on-accent: light-dark(#ffffff, #120d24);
        --amber: light-dark(#b45309, #fbbf24);
        --teal: light-dark(#0f766e, #2dd4bf);
        --shadow: light-dark(0 24px 48px -28px rgba(63, 41, 148, 0.35), 0 24px 48px -24px rgba(0, 0, 0, 0.7));

        --code-bg: #0f0c1a;
        --code-bar: #17132a;
        --code-text: #e6e1f7;
        --code-dim: #8d86a8;
        --code-border: #2a2440;

        --radius: 12px;
      }
      :root[data-theme='light'] {
        color-scheme: light;
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        line-height: 1.15;
        margin: 0;
      }
      p {
        margin: 0;
      }
      a {
        color: var(--accent);
        text-underline-offset: 3px;
      }
      code,
      pre {
        font-family: var(--font-mono);
      }
      :not(pre) > code {
        font-size: 0.86em;
        padding: 0.1em 0.35em;
        border-radius: 5px;
        background: var(--accent-soft);
        color: var(--text);
      }
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 100;
        padding: 0.5rem 1rem;
        background: var(--accent);
        color: var(--on-accent);
        border-radius: 8px;
      }
      .skip-link:focus {
        top: 1rem;
      }

      /* ---- buttons ---- */
      .button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.97rem;
        line-height: 1.2;
        text-decoration: none;
        border: 1px solid transparent;
        transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
      }
      .button:hover {
        transform: translateY(-1px);
      }
      .button-primary {
        background: var(--accent);
        color: var(--on-accent);
      }
      .button-primary:hover {
        background: color-mix(in oklab, var(--accent) 88%, var(--text));
      }
      .button-ghost {
        background: var(--surface);
        border-color: var(--border-strong);
        color: var(--text);
      }
      .button-ghost:hover {
        border-color: var(--accent);
      }
      .button-sm {
        padding: 0.5rem 0.9rem;
        font-size: 0.9rem;
      }
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      /* ---- nav ---- */
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: saturate(160%) blur(12px);
        -webkit-backdrop-filter: saturate(160%) blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--text);
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.08rem;
        letter-spacing: -0.01em;
      }
      .brand img {
        display: block;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.4rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .nav-links a:not(.button) {
        color: var(--muted);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.94rem;
      }
      .nav-links a:not(.button):hover {
        color: var(--text);
      }
      .nav-icon {
        display: inline-flex;
      }
      @media (max-width: 640px) {
        .nav-hide-sm {
          display: none;
        }
        .nav-links {
          gap: 1rem;
        }
      }

      /* ---- hero ---- */
      .hero {
        position: relative;
        padding: 5rem 0 4.5rem;
        overflow: hidden;
        isolation: isolate;
      }
      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
          radial-gradient(ellipse 55% 50% at 12% 0%, color-mix(in srgb, var(--accent) 20%, transparent), transparent 70%),
          radial-gradient(ellipse 40% 40% at 95% 30%, color-mix(in srgb, var(--amber) 12%, transparent), transparent 70%),
          linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 48px 48px,
          linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 48px 48px;
        mask-image: linear-gradient(to bottom, #000 30%, transparent 95%);
        -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 95%);
        opacity: 0.9;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
        gap: 3.5rem;
        align-items: center;
      }
      @media (max-width: 980px) {
        .hero {
          padding: 3.5rem 0 3.5rem;
        }
        .hero-grid {
          grid-template-columns: minmax(0, 1fr);
          gap: 2.75rem;
        }
      }
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        border: 1px solid var(--border-strong);
        background: var(--surface);
        color: var(--text);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 1.5rem;
      }
      .pill:hover {
        border-color: var(--accent);
      }
      .pill-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--teal);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 25%, transparent);
      }
      .hero-title {
        font-size: clamp(2.5rem, 5.6vw, 4.1rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.04;
        margin-bottom: 1.4rem;
        text-wrap: balance;
      }
      .grad {
        background: linear-gradient(100deg, var(--accent) 10%, var(--amber) 95%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .hero-lede {
        font-size: clamp(1.05rem, 1.6vw, 1.2rem);
        color: var(--muted);
        max-width: 36rem;
        margin-bottom: 2rem;
        text-wrap: pretty;
      }
      .quickstart {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.75rem;
        padding: 0.35rem 0.35rem 0.35rem 0.85rem;
        border: 1px dashed var(--border-strong);
        border-radius: 10px;
        max-width: 100%;
        flex-wrap: wrap;
      }
      .quickstart-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }
      .quickstart code {
        padding: 0.4rem 0.75rem;
        border-radius: 7px;
        background: var(--code-bg);
        color: var(--code-text);
        font-size: 0.88rem;
        white-space: nowrap;
        user-select: all;
      }
      .quickstart .prompt {
        color: var(--code-dim);
        user-select: none;
        margin-right: 0.35rem;
      }
      .hero-meta {
        margin-top: 1.25rem;
        font-size: 0.86rem;
        color: var(--muted);
      }

      /* ---- code window ---- */
      .code-window {
        display: grid;
        border-radius: 14px;
        border: 1px solid var(--code-border);
        background: var(--code-bg);
        color: var(--code-text);
        box-shadow: var(--shadow);
        overflow: hidden;
        min-width: 0;
      }
      .tab-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 1px;
        height: 1px;
      }
      .code-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0 1rem;
        background: var(--code-bar);
        border-bottom: 1px solid var(--code-border);
      }
      .code-dots {
        display: inline-flex;
        gap: 6px;
      }
      .code-dots i {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #3b3359;
      }
      .tab-labels {
        display: flex;
        gap: 0.25rem;
      }
      .tab-labels label {
        cursor: pointer;
        padding: 0.8rem 0.75rem 0.7rem;
        font-size: 0.83rem;
        font-weight: 500;
        color: var(--code-dim);
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        user-select: none;
      }
      .tab-labels label:hover {
        color: var(--code-text);
      }
      .code-panels {
        display: grid;
      }
      .code-panel {
        grid-area: 1 / 1;
        visibility: hidden;
        margin: 0;
        padding: 1.25rem 1.25rem 1.1rem;
        overflow-x: auto;
        font-size: 0.84rem;
        line-height: 1.7;
      }
      .code-panel mark {
        display: inline-block;
        min-width: 100%;
        background: rgba(177, 165, 246, 0.12);
        color: inherit;
        box-shadow: inset 2px 0 0 #b1a5f6;
        margin: 0 -1.25rem;
        padding: 0 1.25rem;
        width: calc(100% + 2.5rem);
      }
      #tab-python:checked ~ .code-panels [data-tab='python'],
      #tab-typescript:checked ~ .code-panels [data-tab='typescript'],
      #tab-curl:checked ~ .code-panels [data-tab='curl'] {
        visibility: visible;
      }
      #tab-python:checked ~ .code-bar label[data-tab='python'],
      #tab-typescript:checked ~ .code-bar label[data-tab='typescript'],
      #tab-curl:checked ~ .code-bar label[data-tab='curl'] {
        color: #ffffff;
        border-bottom-color: #b1a5f6;
      }
      #tab-python:focus-visible ~ .code-bar label[data-tab='python'],
      #tab-typescript:focus-visible ~ .code-bar label[data-tab='typescript'],
      #tab-curl:focus-visible ~ .code-bar label[data-tab='curl'] {
        outline: 2px solid #b1a5f6;
        outline-offset: -4px;
        border-radius: 6px;
      }
      .t-k {
        color: #c4b5fd;
      }
      .t-s {
        color: #fcd34d;
      }
      .t-f {
        color: #5eead4;
      }
      .t-dim {
        color: var(--code-dim);
      }
      .t-ok {
        color: #5eead4;
      }
      .code-response {
        border-top: 1px solid var(--code-border);
        background: #0b0914;
        padding: 0.9rem 1.25rem 1rem;
      }
      .code-response-title {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--code-dim);
        margin-bottom: 0.35rem;
      }
      .code-response pre {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.65;
        overflow-x: auto;
      }

      /* ---- providers ---- */
      .providers {
        border-block: 1px solid var(--border);
        background: var(--surface);
      }
      .providers-inner {
        display: flex;
        align-items: center;
        gap: 1.5rem 2rem;
        padding-block: 1.4rem;
        flex-wrap: wrap;
      }
      .providers-title {
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
      }
      .provider-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 1.75rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .provider {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.02rem;
        color: var(--text);
      }
      .provider-mono {
        display: inline-grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--accent-soft);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 600;
      }

      /* ---- sections ---- */
      .section {
        padding: 5.5rem 0;
      }
      .section-alt {
        background: var(--bg-alt);
        border-block: 1px solid var(--border);
      }
      @media (max-width: 640px) {
        .section {
          padding: 4rem 0;
        }
      }
      .section-head {
        max-width: 44rem;
        margin-bottom: 2.75rem;
      }
      .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent);
        margin-bottom: 0.75rem;
      }
      .section-title {
        font-size: clamp(1.85rem, 3.6vw, 2.6rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin-bottom: 0.9rem;
        text-wrap: balance;
      }
      .section-lede {
        font-size: 1.08rem;
        color: var(--muted);
        text-wrap: pretty;
      }
      .section-link {
        margin-top: 2rem;
        font-weight: 600;
      }
      .section-link a {
        text-decoration: none;
      }
      .section-link a:hover {
        text-decoration: underline;
      }

      /* ---- stats ---- */
      .stats {
        padding-top: 5rem;
      }
      .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        overflow: hidden;
      }
      .stat {
        display: flex;
        flex-direction: column;
        padding: 1.75rem 1.5rem;
        border-left: 1px solid var(--border);
      }
      .stat:first-child {
        border-left: 0;
      }
      .stat-label {
        order: 2;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text);
        margin-top: 0.6rem;
      }
      .stat-value {
        order: 1;
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(2.3rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
      }
      .stat-unit {
        font-size: 0.5em;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-left: 0.15em;
        color: var(--muted);
      }
      .stat-detail {
        order: 3;
        margin: 0.25rem 0 0;
        font-size: 0.86rem;
        color: var(--muted);
      }
      @media (max-width: 900px) {
        .stat-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .stat:nth-child(3) {
          border-left: 0;
        }
        .stat:nth-child(n + 3) {
          border-top: 1px solid var(--border);
        }
      }
      @media (max-width: 520px) {
        .stat-grid {
          grid-template-columns: minmax(0, 1fr);
        }
        .stat {
          border-left: 0;
        }
        .stat:nth-child(n + 2) {
          border-top: 1px solid var(--border);
        }
      }

      /* ---- features ---- */
      .feature-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      @media (max-width: 1080px) {
        .feature-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (max-width: 600px) {
        .feature-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      .feature {
        padding: 1.5rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        transition: border-color 0.15s ease, transform 0.15s ease;
      }
      .feature:hover {
        border-color: var(--border-strong);
        transform: translateY(-2px);
      }
      .feature-icon {
        display: block;
        box-sizing: content-box;
        padding: 0.55rem;
        border-radius: 10px;
        background: var(--accent-soft);
        color: var(--accent);
        margin-bottom: 1.1rem;
      }
      .feature-title {
        font-size: 1.06rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-bottom: 0.5rem;
      }
      .feature-body {
        font-size: 0.93rem;
        color: var(--muted);
        line-height: 1.6;
      }
      .feature-body code {
        font-size: 0.8em;
      }

      /* ---- how it works ---- */
      .flow {
        display: grid;
        gap: 1rem;
      }
      .flow-end {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        gap: 0.25rem 0.75rem;
        padding: 0.9rem 1.25rem;
        border-radius: var(--radius);
        border: 1px solid var(--border-strong);
        background: var(--surface);
        text-align: center;
      }
      .flow-end-label {
        font-family: var(--font-display);
        font-weight: 700;
      }
      .flow-end-sub {
        font-size: 0.9rem;
        color: var(--muted);
      }
      .flow-client {
        position: relative;
      }
      .flow-pipeline {
        position: relative;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        padding: 1.25rem;
        border-radius: 16px;
        background:
          linear-gradient(var(--surface), var(--surface)) padding-box,
          linear-gradient(120deg, var(--accent), var(--amber)) border-box;
        border: 1.5px solid transparent;
        column-gap: 0.75rem;
      }
      .flow-pipeline::before {
        content: 'Aether Gateway';
        position: absolute;
        top: -0.75rem;
        left: 1.25rem;
        padding: 0 0.5rem;
        background: var(--bg-alt);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .flow-bypass {
        grid-row: 1;
        grid-column: 3 / 7;
        margin: 0.5rem 8.33% 0.6rem;
        height: 2.1rem;
        border: 1.5px dashed var(--teal);
        border-bottom: 0;
        border-radius: 12px 12px 0 0;
        position: relative;
      }
      .flow-bypass span {
        position: absolute;
        left: 50%;
        top: -0.8rem;
        transform: translateX(-50%);
        white-space: nowrap;
        padding: 0.1rem 0.6rem;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--teal);
        color: var(--teal);
        font-size: 0.76rem;
        font-weight: 600;
      }
      .flow-steps {
        grid-row: 2;
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: subgrid;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .flow-step {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 1rem 0.9rem;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--bg);
      }
      .flow-step:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 1.6rem;
        right: calc(-0.75rem - 1px);
        width: 0.75rem;
        height: 2px;
        background: var(--border-strong);
      }
      .flow-num {
        display: inline-grid;
        place-items: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 50%;
        background: var(--accent);
        color: var(--on-accent);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 600;
        margin-bottom: 0.7rem;
      }
      .flow-step:nth-child(3) .flow-num {
        background: var(--teal);
        color: var(--on-accent);
      }
      .flow-title {
        font-size: 0.98rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
      }
      .flow-body {
        font-size: 0.85rem;
        color: var(--muted);
        line-height: 1.5;
        flex: 1;
      }
      .flow-infra {
        align-self: flex-start;
        margin-top: 0.8rem;
        padding: 0.12rem 0.5rem;
        border-radius: 6px;
        border: 1px solid var(--border);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--muted);
      }
      .flow-note {
        margin-top: 1.5rem;
        color: var(--muted);
        font-size: 0.95rem;
        max-width: 50rem;
      }
      @media (max-width: 980px) {
        .flow-pipeline {
          grid-template-columns: minmax(0, 1fr);
          padding: 1.5rem 1rem 1rem;
        }
        .flow-bypass {
          display: none;
        }
        .flow-steps {
          grid-row: auto;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 0.75rem;
        }
        .flow-step::after {
          display: none;
        }
      }
      @media (max-width: 520px) {
        .flow-steps {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---- compare ---- */
      .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
      }
      .compare {
        width: 100%;
        min-width: 720px;
        border-collapse: collapse;
        font-size: 0.93rem;
      }
      .compare th,
      .compare td {
        padding: 1rem 1.1rem;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--border);
      }
      .compare tbody tr:last-child > * {
        border-bottom: 0;
      }
      .compare thead th {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
      }
      .compare tbody th {
        font-weight: 600;
        color: var(--muted);
        white-space: nowrap;
        width: 9rem;
      }
      .compare td {
        color: var(--muted);
      }
      .compare .is-us {
        background: var(--accent-soft);
        color: var(--text);
        width: 28%;
      }
      .compare thead .is-us {
        color: var(--accent);
      }
      .fit-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }
      @media (max-width: 760px) {
        .fit-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      .fit {
        padding: 1.5rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--surface);
      }
      .fit h3 {
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 0.85rem;
      }
      .fit ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.6rem;
      }
      .fit li {
        position: relative;
        padding-left: 1.6rem;
        color: var(--muted);
        font-size: 0.95rem;
      }
      .fit li::before {
        position: absolute;
        left: 0;
        top: 0;
        font-weight: 700;
      }
      .fit-yes li::before {
        content: '✓';
        color: var(--teal);
      }
      .fit-no li::before {
        content: '→';
        color: var(--amber);
      }
      .footnote {
        margin-top: 1.25rem;
        font-size: 0.82rem;
        color: var(--muted);
      }

      /* ---- final CTA ---- */
      .final-cta {
        padding: 5rem 0;
        background:
          radial-gradient(ellipse 60% 80% at 0% 100%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
          radial-gradient(ellipse 50% 70% at 100% 0%, color-mix(in srgb, var(--amber) 14%, transparent), transparent 70%),
          var(--bg-alt);
        border-top: 1px solid var(--border);
      }
      .final-cta-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 3rem;
        align-items: center;
      }
      @media (max-width: 900px) {
        .final-cta-inner {
          grid-template-columns: minmax(0, 1fr);
          gap: 2rem;
        }
      }
      .final-cta-title {
        font-size: clamp(1.85rem, 3.6vw, 2.6rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin-bottom: 0.9rem;
        text-wrap: balance;
      }
      .final-cta-lede {
        color: var(--muted);
        font-size: 1.05rem;
        margin-bottom: 1.75rem;
        max-width: 34rem;
      }
      .terminal {
        margin: 0;
        padding: 1.4rem 1.5rem;
        border-radius: 14px;
        border: 1px solid var(--code-border);
        background: var(--code-bg);
        color: var(--code-text);
        font-size: 0.88rem;
        line-height: 1.85;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        box-shadow: var(--shadow);
      }

      /* ---- footer ---- */
      .footer {
        padding: 3.5rem 0 3rem;
        border-top: 1px solid var(--border);
        background: var(--bg);
        font-size: 0.93rem;
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        gap: 2rem;
      }
      @media (max-width: 760px) {
        .footer-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .footer-brand {
          grid-column: 1 / -1;
        }
      }
      .footer-brand p {
        margin-top: 0.75rem;
        color: var(--muted);
        max-width: 22rem;
      }
      .footer-title {
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
        margin-bottom: 0.8rem;
      }
      .footer ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
      }
      .footer ul a {
        color: var(--text);
        text-decoration: none;
      }
      .footer ul a:hover {
        color: var(--accent);
        text-decoration: underline;
      }
    </style>
  </body>
</html>
