{
  "title": "Aether Gateway",
  "uid": "aether-gateway",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["aether-gateway", "m5"],
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "RPS by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (route) (rate(aether_gateway_requests_total[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency by provider (p50/p95/p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "aether_gateway_request_duration_seconds{quantile=\"0.5\"}",
          "legendFormat": "{{provider}} p50",
          "refId": "A"
        },
        {
          "expr": "aether_gateway_request_duration_seconds{quantile=\"0.95\"}",
          "legendFormat": "{{provider}} p95",
          "refId": "B"
        },
        {
          "expr": "aether_gateway_request_duration_seconds{quantile=\"0.99\"}",
          "legendFormat": "{{provider}} p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache hit rate over time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(aether_gateway_requests_total{cache_outcome=~\"EXACT_HIT|SEMANTIC_HIT\"}[5m])) / sum(rate(aether_gateway_requests_total[5m]))",
          "legendFormat": "cache hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cumulative spend vs. spend avoided",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(aether_gateway_cost_usd_total)",
          "legendFormat": "cumulative spend",
          "refId": "A"
        },
        {
          "expr": "sum(aether_gateway_savings_usd_total)",
          "legendFormat": "cumulative spend avoided (cache)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Breaker state timeline",
      "type": "state-timeline",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "aether_gateway_breaker_state == 1",
          "legendFormat": "{{provider}}/{{model}} {{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "In-flight streams",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "aether_gateway_in_flight_streams",
          "legendFormat": "in-flight streams",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Top keys by cost",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "expr": "topk(10, sum by (api_key) (aether_gateway_cost_usd_total))",
          "legendFormat": "{{api_key}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Error rate by provider",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (provider) (rate(aether_gateway_requests_total{status=\"FAILED\"}[5m])) / sum by (provider) (rate(aether_gateway_requests_total[5m]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    }
  ]
}
